<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Def_Fisc" targetNamespace="http://copel.com/vcm/fiscalizacao" exporter="Fiscalizacao de Obras" exporterVersion="1.6">
 <collaboration id="Colab"><participant id="P_fisc" name="Fiscalização de obras empenhadas · VCM" processRef="Proc_fisc"/></collaboration>
 <process id="Proc_fisc" name="Fiscalização de obras empenhadas" isExecutable="false">
  <laneSet id="LS">
   <lane id="L_ges" name="Gestor · Copel/VCM"><flowNodeRef>ini</flowNodeRef><flowNodeRef>t_sap0</flowNodeRef><flowNodeRef>t_aes</flowNodeRef><flowNodeRef>t_pdf</flowNodeRef><flowNodeRef>t_conf</flowNodeRef><flowNodeRef>t_sap</flowNodeRef><flowNodeRef>t_env</flowNodeRef><flowNodeRef>t_arq</flowNodeRef><flowNodeRef>fim_g</flowNodeRef></lane>
   <lane id="L_sis" name="App Fiscalização de Obras"><flowNodeRef>t_laes</flowNodeRef><flowNodeRef>t_ler</flowNodeRef><flowNodeRef>t_pub</flowNodeRef><flowNodeRef>t_av</flowNodeRef><flowNodeRef>g_tod</flowNodeRef><flowNodeRef>t_enc</flowNodeRef><flowNodeRef>t_car</flowNodeRef><flowNodeRef>g_par</flowNodeRef></lane>
   <lane id="L_emp" name="Empreiteira · equipe de campo"><flowNodeRef>t_exe</flowNodeRef><flowNodeRef>t_cor</flowNodeRef><flowNodeRef>t_ass</flowNodeRef><flowNodeRef>t_bx</flowNodeRef><flowNodeRef>fim_e</flowNodeRef><flowNodeRef>t_cad</flowNodeRef></lane>
   <lane id="L_fis" name="Fiscal · Copel"><flowNodeRef>t_fis</flowNodeRef><flowNodeRef>g_ok</flowNodeRef><flowNodeRef>t_apr</flowNodeRef></lane>
  </laneSet>
  <startEvent id="ini" name="PEP liberado para empenho (LIB)"><outgoing>f1</outgoing></startEvent>
  <task id="t_sap0" name="Empenhar no SAP e gerar a AES (AES)"><incoming>f1</incoming><outgoing>f1b</outgoing></task>
  <task id="t_aes" name="Subir o PDF da AES no app"><incoming>f1b</incoming><outgoing>f1c</outgoing></task>
  <task id="t_laes" name="Ler a AES: empreiteira, contrato e projetos (PEP, US, prazo)"><incoming>f1c</incoming><outgoing>f1d</outgoing></task>
  <task id="t_pdf" name="Subir os PDFs dos projetos (vários de uma vez)"><incoming>f1d</incoming><outgoing>f2</outgoing></task>
  <task id="t_ler" name="Ler carimbo, folhas e postes e casar cada PDF com o item da AES"><incoming>f2</incoming><outgoing>f3</outgoing></task>
  <task id="t_conf" name="Conferir os postes da planta e empenhar"><incoming>f3</incoming><outgoing>f4</outgoing></task>
  <task id="t_pub" name="Publicar obra para a empreiteira (Empenhada)"><incoming>f4</incoming><outgoing>f5</outgoing></task>
  <task id="t_exe" name="Executar e registrar cada poste no app (foto, GPS, alteração)"><incoming>f5</incoming><outgoing>f6</outgoing></task>
  <task id="t_av" name="Atualizar avanço, US e painel (Em execução / Executada)"><incoming>f6</incoming><outgoing>f7</outgoing></task>
  <task id="t_fis" name="Fiscalizar poste (em campo ou pela tela da obra)"><incoming>f7</incoming><incoming>f11</incoming><incoming>f13</incoming><outgoing>f8</outgoing></task>
  <exclusiveGateway id="g_ok" name="Poste conforme?" gatewayDirection="Diverging"><incoming>f8</incoming><outgoing>f9</outgoing><outgoing>f10</outgoing></exclusiveGateway>
  <task id="t_cor" name="Corrigir o poste e registrar de novo"><incoming>f10</incoming><outgoing>f11</outgoing></task>
  <task id="t_apr" name="Aprovar poste · medido"><incoming>f9</incoming><outgoing>f12</outgoing></task>
  <exclusiveGateway id="g_tod" name="Todos os postes aprovados?" gatewayDirection="Diverging"><incoming>f12</incoming><outgoing>f13</outgoing><outgoing>f14</outgoing></exclusiveGateway>
  <task id="t_enc" name="Encerramento final: obra vai para o Histórico e sai do painel"><incoming>f14</incoming><outgoing>f15</outgoing></task>
  <task id="t_sap" name="Medição final e emissão da FF e do BMD no SAP"><incoming>f15</incoming><outgoing>f16</outgoing></task>
  <task id="t_env" name="Enviar PDF do BMD, FF e vistoria para assinatura"><incoming>f16</incoming><outgoing>f17</outgoing></task>
  <task id="t_ass" name="Escolher o local da assinatura e assinar com o PIN"><incoming>f17b</incoming><outgoing>f18</outgoing></task>
  <task id="t_car" name="Aplicar assinatura, carimbo e folha de assinatura (SHA-256) e guardar"><incoming>f18</incoming><outgoing>f19</outgoing></task>
  <parallelGateway id="g_par" name="" gatewayDirection="Diverging"><incoming>f19</incoming><outgoing>f20</outgoing><outgoing>f21</outgoing></parallelGateway>
  <task id="t_bx" name="Baixar PDF assinado"><incoming>f20</incoming><outgoing>f22</outgoing></task>
  <task id="t_arq" name="Baixar assinados e arquivar no protocolo"><incoming>f21</incoming><outgoing>f23</outgoing></task>
  <endEvent id="fim_e" name="Documentos com a empreiteira"><incoming>f22</incoming></endEvent>
  <endEvent id="fim_g" name="Obra encerrada (ENCE / CONC)"><incoming>f23</incoming></endEvent>
  <task id="t_cad" name="1º acesso: cadastrar assinatura do responsável e PIN"><incoming>f17</incoming><outgoing>f17b</outgoing></task>
  <sequenceFlow id="f1" name="" sourceRef="ini" targetRef="t_sap0"/>
  <sequenceFlow id="f1b" name="" sourceRef="t_sap0" targetRef="t_aes"/>
  <sequenceFlow id="f1c" name="" sourceRef="t_aes" targetRef="t_laes"/>
  <sequenceFlow id="f1d" name="" sourceRef="t_laes" targetRef="t_pdf"/>
  <sequenceFlow id="f2" name="" sourceRef="t_pdf" targetRef="t_ler"/>
  <sequenceFlow id="f3" name="" sourceRef="t_ler" targetRef="t_conf"/>
  <sequenceFlow id="f4" name="" sourceRef="t_conf" targetRef="t_pub"/>
  <sequenceFlow id="f5" name="" sourceRef="t_pub" targetRef="t_exe"/>
  <sequenceFlow id="f6" name="" sourceRef="t_exe" targetRef="t_av"/>
  <sequenceFlow id="f7" name="" sourceRef="t_av" targetRef="t_fis"/>
  <sequenceFlow id="f8" name="" sourceRef="t_fis" targetRef="g_ok"/>
  <sequenceFlow id="f9" name="Sim" sourceRef="g_ok" targetRef="t_apr"/>
  <sequenceFlow id="f10" name="Não: reprova com motivo" sourceRef="g_ok" targetRef="t_cor"/>
  <sequenceFlow id="f11" name="" sourceRef="t_cor" targetRef="t_fis"/>
  <sequenceFlow id="f12" name="" sourceRef="t_apr" targetRef="g_tod"/>
  <sequenceFlow id="f13" name="Não: próximo poste" sourceRef="g_tod" targetRef="t_fis"/>
  <sequenceFlow id="f14" name="Sim" sourceRef="g_tod" targetRef="t_enc"/>
  <sequenceFlow id="f15" name="" sourceRef="t_enc" targetRef="t_sap"/>
  <sequenceFlow id="f16" name="" sourceRef="t_sap" targetRef="t_env"/>
  <sequenceFlow id="f17" name="" sourceRef="t_env" targetRef="t_cad"/>
  <sequenceFlow id="f17b" name="" sourceRef="t_cad" targetRef="t_ass"/>
  <sequenceFlow id="f18" name="" sourceRef="t_ass" targetRef="t_car"/>
  <sequenceFlow id="f19" name="" sourceRef="t_car" targetRef="g_par"/>
  <sequenceFlow id="f20" name="" sourceRef="g_par" targetRef="t_bx"/>
  <sequenceFlow id="f21" name="" sourceRef="g_par" targetRef="t_arq"/>
  <sequenceFlow id="f22" name="" sourceRef="t_bx" targetRef="fim_e"/>
  <sequenceFlow id="f23" name="" sourceRef="t_arq" targetRef="fim_g"/>
 </process>
